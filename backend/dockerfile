#Imagen base ligera de Python
FROM python:3.14-slim

# Creamos el directorio de trabajo
WORKDIR /app

# Copiamos todo el contenido del proyecto al contenedor
COPY ./poetry.lock ./pyproject.toml .

# Exponer el pierto donde correrá la app
EXPOSE 8000

#Instalamos poetry
RUN pip install --no-cache-dir "poetry"

# Evitamos que poetry cree un virtualenv (instalamos en el Python del sistema)
RUN poetry config virtualenvs.create false

# Instalamos el resto de dependencias con Poetry
RUN poetry install --no-root --only main --no-cache

# Por último definimos el comando para correr la app
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]