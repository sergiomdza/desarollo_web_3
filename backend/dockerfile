# Imagen base ligera de Python
FROM python:3.12-slim

# Creamos directorio de trabajo
WORKDIR /app

# Copiamos todo el contenido del proyecto al contenedor
COPY . .

# Exponemos el puerto donde correrá la app
EXPOSE 8000

# Instalamos Poetry
RUN pip install --no-cache-dir poetry

# Instalamos las dependencias con Poetry
RUN poetry install --no-root --only main --no-cache

# Definimos el comando para correr la aplicación
CMD ["poetry", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]